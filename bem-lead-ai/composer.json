{
  "name": "bem-dakar/bem-lead-ai",
  "description": "Conseiller IA & Lead Scoring Comportemental pour BEM Dakar — plugin WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "BemLeadAi\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BemLeadAi\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "scripts": {
    "test": "phpunit"
  }
}
